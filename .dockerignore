# Allowlist: everything else (including config/, server/, supabase/, archives,
# .git, IDE state, caches, source_assets and private backups) stays out.
**
!Dockerfile
!Caddyfile
!pubspec.yaml
!pubspec.lock
!lib/
!lib/**
!web/
!web/**
!assets/
!assets/**
!deploy/
!deploy/validate_client_config.py
!deploy/flutter_service_worker.js

# Defense in depth, including secrets accidentally placed in allowed folders.
**/.git
**/.idea
**/.vscode
**/.dart_tool
**/node_modules
**/__pycache__
**/.env
**/.env.*
**/local.json
**/id_rsa*
**/id_ed25519*
**/.ssh
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/key.properties
**/*.dump
**/*.backup
**/*.bak
**/*.db
**/*.sqlite*
**/*.zip
**/*.rar
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.7z
**/*.tmp
**/*.temp
**/*.log
**/PRE_BACKUP_*
**/VERIFIED_ADMIN*
